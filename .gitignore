# ============================================================
# Home Assistant Config — .gitignore
# Updated: 2026-07-05
# ============================================================

# ─── HA Databases ───────────────────────────────────────────
*.db
*.db-shm
*.db-wal

# ─── Logs ───────────────────────────────────────────────────
*.log
*.log.*
*.log.old
*.log.fault
logs/

# ─── Secrets & Credentials ──────────────────────────────────
secrets.yaml
*.secret
.ha_token
.ha_cursor_agent_key
.shopping_list.json
ha_tracker_zones.json
lutron_caseta-*.pem

# ─── HA Internal State (not config) ─────────────────────────
.storage/
.storage_backup_before_recovery/
.cloud/
.google.token
.ha_run.lock

# ─── Dependencies / Runtime ─────────────────────────────────
deps/
tts/

# ─── HACS / Frontend Community Files ────────────────────────
# These are downloaded assets, not your config
www/

# ─── HACS Custom Components ──────────────────────────────────
# Downloaded integrations — managed by HACS, not hand-authored
# If you want to track a specific custom component, force-include it:
#   !custom_components/my_handwritten_component/
custom_components/

# ─── Git helper repos ─────────────────────────────────────────
ha_vibecode_git/

# ─── ESPHome (has its own git repo) ─────────────────────────
esphome/

# ─── Zigbee2MQTT (has its own git repo) ─────────────────────
zigbee2mqtt/

# ─── HA Backup Archives ─────────────────────────────────────
backup/

# ─── Media & Binary Assets ──────────────────────────────────
image/
media/
llmvision/
f1_replay_cache/

# ─── Binary Executables ─────────────────────────────────────
go2rtc-*

# ─── SSL Certificates (secrets) ─────────────────────────────
ssl/
*.pem
*.crt
*.key

# ─── Community Themes (managed by HACS) ─────────────────────
# Import themes via HACS — don't vendor them here
themes/catppuccin/
themes/ios-themes/
themes/Frosted Glass/
themes/metro/
themes/google_theme/
themes/minimalist-desktop/
themes/minimalist-ios-tapbar/
themes/minimalist-mobile-tapbar/
themes/minimalist-mobile/
themes/synthwave/

# ─── Community Blueprints (import via HA Blueprint URL) ──────
# Official HA blueprints (blueprints/automation/homeassistant/) are kept.
# All others are community blueprints — import via the HA UI "Import Blueprint" URL.
blueprints/automation/Blackshome/
blueprints/automation/LanKing/
blueprints/automation/Ltek/
blueprints/automation/Stringer/
blueprints/automation/TJ-developer/
blueprints/automation/acdye/
blueprints/automation/alexsotoaguilera/
blueprints/automation/bferd/
blueprints/automation/clousberg/
blueprints/automation/damru/
blueprints/automation/fapgomes/
blueprints/automation/fljan09/
blueprints/automation/gregtakacs/
blueprints/automation/ha_tracker/
blueprints/automation/jrfigura/
blueprints/automation/lehenandmartin/
blueprints/automation/marc-romu/
blueprints/automation/niro1987/
blueprints/automation/olli-dot-dev/
blueprints/automation/panhans/
blueprints/automation/seamus65/
blueprints/automation/soflane/
blueprints/automation/willhaggan/
blueprints/automation/willumpie82/
blueprints/automation/wwohl/
blueprints/script/chrisrbarnett/

# ─── OpenHands Runtime ──────────────────────────────────────
packages/openhands/

# ─── Temporary / OS Files ───────────────────────────────────
*.tmp
*.bak
*.swp
*~
.DS_Store
Thumbs.db

# ─── IDE ────────────────────────────────────────────────────
.vscode/
.idea/

# ─── Python Cache ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class

# ─── Node Modules ───────────────────────────────────────────
node_modules/

# ─── Nest Integration ───────────────────────────────────────
nest/

# ─── Known Devices ──────────────────────────────────────────
www/known_devices.yaml

# ─── HA Runtime Version Marker ──────────────────────────────
.HA_VERSION

# ─── Stray Manual Backups ───────────────────────────────────
*.bak-*

# ─── HACS External Components ───────────────────────────────
# Same as custom_components/ — downloaded via HACS, not hand-authored
external_components/

# ─── AI Tool / Agent Session State ──────────────────────────
# Local tool caches and session config — not repo config
.codex/
.claude/
.cache/
openclaw/
